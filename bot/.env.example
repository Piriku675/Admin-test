# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy to .env and fill in values (never commit .env)
# On Render: add these as Environment Variables in the dashboard
# ─────────────────────────────────────────────────────────────────────────────

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user ID (get from @userinfobot) — only this user can admin
ADMIN_CHAT_ID=your_telegram_user_id_here

# Firebase service account JSON — paste the entire JSON as one line
# On Render: set as a Secret File at /etc/secrets/serviceAccountKey.json
# OR paste minified JSON here as FIREBASE_SERVICE_KEY
FIREBASE_SERVICE_KEY={"type":"service_account","project_id":"..."}

# Firebase Storage bucket (e.g. your-project.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Port (Render sets this automatically)
PORT=3000
