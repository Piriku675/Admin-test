rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // PUBLIC CMS CONTENT (READ ONLY)
    // ─────────────────────────────────────────────

    // Site core content (settings, hero, about, contact)
    match /site/{docId} {
      allow read: if true;
      allow write: if false; // Telegram bot uses Admin SDK (bypasses rules)
    }

    // Portfolio projects
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // CV / timeline entries
    match /cv/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Skills groups
    match /skills/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Categories (IMPORTANT: you added this recently)
    match /categories/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // HARD DENY EVERYTHING ELSE
    // ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}